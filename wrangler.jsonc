{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "atacado-seguro",
  "main": "src/index.js",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "atacado-seguro", "database_id": "aad73923-d1f1-4633-9c41-c0537ee739cb", "migrations_dir": "migrations" }],
  "triggers": { "crons": ["17 7 * * *"] },
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "vars": {
    "ITERACOES_SENHA": "100000",
    "MODO_DEMO": "1",
    "TURNSTILE_HOSTNAMES": "atacado-seguro.contato-aea.workers.dev",
    "SENTRY_DSN": "https://555acc5232b4a380e81c822064fdc925@o4512385410203648.ingest.us.sentry.io/4512385726742528"
  }
}
